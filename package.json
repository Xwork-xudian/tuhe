{
  "name": "tuhe-demo",
  "version": "1.0.0",
  "description": "途合演示版：跨平台收藏地点、地图可视化与世界迷雾足迹管理",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test server/__tests__/*.test.js",
    "typecheck": "tsc --noEmit",
    "demo": "TUHE_DEMO=1 node server/index.js"
  },
  "keywords": [
    "places",
    "map",
    "leaflet",
    "travel",
    "fog-of-world",
    "demo"
  ],
  "author": "Tuhe Demo",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@tonybolivar/fog-of-world-parser": "^0.1.0",
    "express": "^5.3.0",
    "fflate": "^0.8.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
